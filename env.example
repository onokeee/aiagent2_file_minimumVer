# ===== このファイルについて =====
# env.example をコピーして env を作り、必要なところだけ書き換えます。
#
# 設定の一部はこのファイルではなく、コード内に直接書いてあります。
# 「env に書いたのに効かない」を避けるため、置き場所を1つに寄せたものです。
#
#   config.py … OPENAI_MODEL / SEND_OK_MAIL_DOMAIN / ADMIN_USER / ADMIN_PASS
#   run.py    … HOST / PORT / DEBUG（待ち受け先。既定 0.0.0.0:8000）
#
# 実際に env で設定が要るのは OPENAI_BASE_URL と OPENAI_API_KEY の2つだけです。
# 以下のコメントアウトされた項目は、既定値から変えたいときだけ有効にしてください。


# ===== OpenAI / OpenAI互換API の設定 =====
# 公式OpenAIなら base_url は https://api.openai.com/v1。
# /v1 以外のパスのOpenAI互換エンドポイントを使う場合は、そのパスまでを指定する
# （OpenAI SDK が末尾に /chat/completions を自動付与するため、/chat/completions は付けない）。
export OPENAI_BASE_URL="https://api.openai.com/v1"

# 認証: ヘッダー Authorization: Bearer <API_KEY>（SDKが api_key から自動付与）
export OPENAI_API_KEY="<API_KEY>"

# モデル名は config.py に直接書いています（OPENAI_MODEL）。
# ここに書いても読まれません。

# 生成パラメータ（任意）。SQL生成の安定のため temperature は 0 推奨。
# export OPENAI_TEMPERATURE="0"
# export OPENAI_TOP_P="0.95"
# export OPENAI_MAX_TOKENS="1500"

# ===== ログイン =====
# local … auth_users.yaml のユーザーで認証（社内LDAP導入までの暫定）
# http  … 社内の認証API(LDAP連携)にHTTPで問い合わせる
export AUTH_PROVIDER="local"

# 管理者とみなすグループ名。データカタログ・取り込み・モデル設定・メール設定は
# このグループに属する人だけが開けます。
# 認証APIがグループを返さない構成では使われません
# （管理者は config.py の ADMIN_USER で入る admin だけになります）。
export AUTH_ADMIN_GROUP="admin"

# --- 常設の管理者アカウント ---
# LDAP や auth_users.yaml とは別枠で、必ずログインできる管理者を1人だけ用意します。
# LDAPが落ちている・まだ繋いでいない状況でも設定画面に入るための非常口です。
#
# ID とパスワードは config.py に直接書いています（ADMIN_USER / ADMIN_PASS）。
# ここに書いても読まれません。変えるときは config.py を書き換えてください。
# ADMIN_PASS を空文字にすると、このアカウント自体が無効になります
# （空パスワードでログインできてしまう事故を防ぐため）。

# ローカル認証のユーザー定義ファイル（manage_users.py が読み書きする）
# export AUTH_USERS_FILE="./auth_users.yaml"

# --- AUTH_PROVIDER=http のとき（社内LDAP認証APIの仕様に合わせる）---
# 送信: {"<USER_FIELD>": "入力されたID", "<PASS_FIELD>": "入力されたパスワード"} を JSON で POST
# 応答: JSON。どのキーを読むかを下で指定する（"user.name" のようにネストも指定可）
# export AUTH_API_URL="https://example.co.jp/api/auth"
# export AUTH_API_USER_FIELD="username"
# export AUTH_API_PASS_FIELD="password"
# export AUTH_API_SUCCESS_FIELD="authenticated   # 空ならHTTP200を成功とみなす"
# export AUTH_API_DISPLAY_FIELD="display_name"
# export AUTH_API_TIMEOUT="10"
#
# 応答にグループ一覧が含まれるときだけ、その場所を指定します。
# 空のまま（既定）なら、認証APIで入った人は全員が一般ユーザーになり、
# 管理者は config.py の ADMIN_PASS で入る admin だけになります。
# export AUTH_API_GROUPS_FIELD="memberOf"

# ===== データの場所（任意）=====
# export DATA_DIR="./data"

# ===== 取り込み（Excel/CSV → DB）=====
# ここに置かれたファイルだけを「🗄 データ取り込み」画面から読み込む。
# 画面からパスは打たせないので、広いフォルダ（C:\ や / やユーザーフォルダ直下）は
# 指定しないこと。既定は ./import
#
# 複数指定は ";" 区切り（Linuxでは ":" も可）。開発機と本番でこの行だけ入れ替える運用を想定。
#   開発(Windows): IMPORT_DIRS=C:\shared\取込用;D:\data\csv
#   本番(Linux)  : IMPORT_DIRS=/mnt/real/real2;/mnt/real/real3
# export IMPORT_DIRS="/mnt/real/real2"

# 1ファイルの上限(MB) / 1テーブルの行数上限
# export IMPORT_MAX_FILE_MB="100"
# export IMPORT_MAX_ROWS="1000000"

# 探索の深さ。0=無制限（既定。指定フォルダより下は全部見る）
# export IMPORT_SCAN_DEPTH="0"
# 一覧に出す最大件数（共有フォルダが巨大なときの保険）
# export IMPORT_MAX_FILES="2000"

# --- 定期取り込み ---
# ジョブ定義の置き場。cron から refresh.py を動かすときはアプリと同じ場所を指すこと。
# export IMPORT_JOBS_FILE="./data/import_jobs.yaml"
# 取得日時の列名（更新の仕方によらず必ず追加される）
# export IMPORT_TIMESTAMP_COLUMN="取得日時"

# 画面から取り込み元フォルダを追加できるようにするか（管理者のみ操作可）
# export IMPORT_DIRS_EDITABLE="true"
# 手元のPCからのアップロード取り込みを許可するか（既定は無効）
# export IMPORT_ALLOW_UPLOAD="false"
# 自動実行（アプリのプロセス内でスレッドを回す。cron は不要）。
# アプリを起動している間、画面を誰も開いていなくても定期取り込みが動く。
# export IMPORT_SCHEDULER="true"
# 何秒ごとに「期限が来たジョブがあるか」を確認するか
# export IMPORT_SCHEDULER_TICK_SEC="60"

# --- 更新履歴 ---
# 取り込み1回ごとの記録（1行1件のJSON）。DBの管理タブの「更新履歴」に出る。
# export IMPORT_HISTORY_FILE="./data/import_history.jsonl"
# 残す件数の上限。超えたら古いものから捨てる。
# export IMPORT_HISTORY_MAX="5000"
# テーブル詳細に出すサンプル行数
# export IMPORT_SAMPLE_ROWS="20"

# --- メール送信（SMTP） ---
# 設定しないとメール機能は使えない（下書きは作れるが送信できない）。
# 送信できるのは、チャット画面で下書きを確認して「送信」を押したときだけ。
#
# ホスト・ポート・タイムアウトは「メール設定」画面から変更できます
# （要管理者・再起動不要）。ここに書いた値は画面で未設定のときの初期値で、
# 画面から保存すると data/mail_settings.yaml に入りそちらが優先されます。
# export SMTP_HOST="relay.example.co.jp"
# export SMTP_PORT="25"
# export SMTP_TIMEOUT="20"
#
# 暗号化と認証は社内リレー前提（なし）のため画面には出しません。
# Gmail など外部SMTPを使う環境では、ここで指定してアプリを再起動してください。
# 認証なしのときは SMTP_USER を空のままに（空なら login() を呼びません）。
# export SMTP_SECURITY="none           # none / starttls / ssl"
# export SMTP_USER=""
# export SMTP_PASSWORD="ここに書く（このファイルは配布しないこと）"
#
# export SMTP_SENDER="bi-report@example.co.jp"
# export SMTP_SENDER_NAME="DB分析アシスタント"
# 送信先は「メール設定」画面で1件ずつ登録します。
# 登録が0件のあいだは、どこにも送信できません（設定忘れによる誤送信を防ぐため）。
#
# そのうえで、登録してよいドメインを config.py に直接書いています
# （SEND_OK_MAIL_DOMAIN）。ここに書いても読まれません。
# 一度に送れる宛先の上限
# export SMTP_MAX_RECIPIENTS="20"
# true のあいだは実際に送らず、内容の確認だけ行う（既定）。
# 本番のSMTPで疎通を確認してから false にすること。
# export SMTP_DRY_RUN="true"
# 画面から保存した設定の置き場
# export SMTP_SETTINGS_FILE="./data/mail_settings.yaml"

# ===== エージェントの動作 =====
# 1質問あたり「考えてツールを呼ぶ」を何往復まで許すか（暴走を止める安全弁）。
# 分析→グラフ→レポートのような多段の作業をよく行うなら少し増やす。
# export MAX_AGENT_STEPS="10"
# 質問ごとに、どのDBのカタログをAIに渡すか。
#   auto   … カタログ全体が「選択中モデルの読める量」に収まるなら全DB直載せ。
#            超えたらDBルーターで関係するDBだけに絞り、詳細を保つ（既定）
#   router … 常にルーターで絞る（無関係なDBを本番プロンプトに入れない）
#   all    … 常に全DB。収まらなければ要約モード（列名が渡らない）に落ちる
# export SCOPE_MODE="auto"
# 表に無いモデルの文脈量の仮の値（トークン）。実際の登録は「モデル設定」画面で行う
# （公式の表にあるモデルは自動。上限文字数を手で決める設定は無い）。
# export MODEL_CONTEXT_DEFAULT="128000"

# ===== レポート（Word / PowerPoint） =====
# 文書に使う日本語フォント。開く側のPCに入っているものを指定する。
# export REPORT_FONT_JA="Meiryo"
# 表紙やフッタに入れる組織名
# export REPORT_ORG="営業企画部"
# 文書に貼るグラフ画像の大きさ（px）と倍率
# export REPORT_IMAGE_WIDTH="1200"
# export REPORT_IMAGE_HEIGHT="650"
# export REPORT_IMAGE_SCALE="2"

# ===== モデルの選択と画像 =====
# 以下は管理者が「モデル設定」画面から変更できます（再起動不要）。
# ここに書いた値は、画面でまだ何も決めていないときの初期値です。
#
# チャットのプルダウンに出すモデル。空ならAPIの /models から取りに行く。
# export OPENAI_MODELS="gpt-4o-mini;gpt-4o;5.6sol"
# 未選択の利用者が使うモデルは config.py の OPENAI_MODEL です（ここでは設定不可）。
# なお config.py の OPENAI_MODEL は、DBルーターや各種AI下書きでも常に使われます。
# 画像を送れるモデル（名前の一部でよい）。ここに当てはまるものだけ添付ボタンが出る。
# export OPENAI_VISION_MODELS="gpt-4o;gpt-4.1;gpt-5;o4;sol;vision"
#
# 利用者が選んだモデルと対象データは data/users/<ユーザー>/prefs.yaml に残ります
# （ログアウトしても次に入ったときは同じ状態から始まります）
# 管理者が「モデル設定」画面で保存した内容の置き場
# export MODEL_SETTINGS_FILE="./data/model_settings.yaml"
# 画像1枚あたりの上限(MB)と、1メッセージに付けられる枚数
# export IMAGE_MAX_MB="8"
# export IMAGE_MAX_COUNT="4"

# ===== チャット履歴 =====
# 保存期間（日）。最後に使った日からこれを過ぎた会話は自動で消えます。
# 既定は90日（3か月）。0 にすると期限では消しません（本数の上限だけ効きます）。
# export CHAT_HISTORY_DAYS="90"
